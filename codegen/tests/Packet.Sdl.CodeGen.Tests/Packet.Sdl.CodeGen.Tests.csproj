<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <None Include="Fixtures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- The test project shells out to the codegen tool as a subprocess
         (black-box integration testing) rather than referencing it directly,
         so internal refactoring of Program.cs doesn't break tests. We only
         need the project on the build graph so it's built before tests run. -->
    <ProjectReference Include="..\..\src\Packet.Sdl.CodeGen\Packet.Sdl.CodeGen.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
    </ProjectReference>
    <!-- Transcribe is API-tested directly: tests load each committed
         graphml, run the walker, and assert on the IR. -->
    <ProjectReference Include="..\..\src\Packet.Sdl.Transcribe\Packet.Sdl.Transcribe.csproj" />
    <!-- IR is API-tested directly: ResolverStaleReadTests drives Resolver.Resolve. -->
    <ProjectReference Include="..\..\src\Packet.Sdl.IR\Packet.Sdl.IR.csproj" />
    <!-- The TLA+ emitter is API-tested directly: TlaEmitterTests renders spec/json and compares it with the committed spec/tla. -->
    <ProjectReference Include="..\..\src\Packet.Sdl.CodeGen.Tla\Packet.Sdl.CodeGen.Tla.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- JsonSchema.Net is used by the JSON emitter tests to re-validate
         generated .g.json files against the generated schema.json, as a
         second-opinion check independent of the emitter's own internal
         validation. -->
    <PackageReference Include="JsonSchema.Net" />
    <!-- CitationsSchemaTests reads YAML sidecars and converts them to
         JsonNode for schema validation. -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

</Project>
