\* Every state page: Pages[state][event] is the sequence of that page's
\* transitions on that event, in file order.
Pages ==
       ("AwaitingConnection" :> Page_AwaitingConnection)
    @@ ("AwaitingRelease" :> Page_AwaitingRelease)
    @@ ("AwaitingV22Connection" :> Page_AwaitingV22Connection)
    @@ ("Connected" :> Page_Connected)
    @@ ("Disconnected" :> Page_Disconnected)
    @@ ("TimerRecovery" :> Page_TimerRecovery)

(***************************************************************************)
(* Subroutines                                                             *)
(***************************************************************************)
\* Subroutines[name] is the sequence of that subroutine's guarded paths.
Subroutines ==
       ("Set_Version_2_2" :> << \* figc4.7
        [id |-> "t01_set_version_2_2",
         guard |-> << >>,
         loops |-> << >>,
         actions |-> << Box("processing", "Set Half Duplex"),
                        Box("processing", "Set Selective Reject"),
                        Box("processing", "Modulo := 128"),
                        Box("processing", "N1 := 2048"),
                        Box("processing", "k := 32"),
                        Box("processing", "T2 := 3000"),
                        Box("processing", "N2 := 10") >>]
    >>)
    @@ ("UI_Check" :> << \* figc4.7
        [id |-> "t01_ui_check_no",
         guard |-> << Not("command") >>,
         loops |-> << >>,
         actions |-> << Box("signal_upper", "DL-ERROR Indication (Q)") >>],
        [id |-> "t02_ui_check_yes_yes",
         guard |-> << Is("command"), Is("info_field_length_le_N1_and_content_is_octet_aligned") >>,
         loops |-> << >>,
         actions |-> << Box("signal_upper", "DL_UNIT_DATA_indication") >>],
        [id |-> "t03_ui_check_yes_no",
         guard |-> << Is("command"), Not("info_field_length_le_N1_and_content_is_octet_aligned") >>,
         loops |-> << >>,
         actions |-> << Box("signal_upper", "DL-ERROR Indication (K)") >>]
    >>)
    @@ ("Select_T1" :> << \* figc4.7
        [id |-> "t01_select_t1_yes",
         guard |-> << Is("RC_eq_0") >>,
         loops |-> << >>,
         actions |-> << Box("processing", "SRT := 7(SRT)/8 + (T1)/8 - (Remaining Time on T1 When Last Stopped)/8"),
                        Box("processing", "Next T1 := 2 * SRT") >>],
        [id |-> "t02_select_t1_no_no",
         guard |-> << Not("RC_eq_0"), Not("T1_expired") >>,
         loops |-> << >>,
         actions |-> << >>],
        [id |-> "t03_select_t1_no_yes",
         guard |-> << Not("RC_eq_0"), Is("T1_expired") >>,
         loops |-> << >>,
         actions |-> << Box("processing", "Next T1 := (RC*0.25)+SRT*2") >>]
    >>)
    @@ ("Set_Version_2_0" :> << \* figc4.7
        [id |-> "t01_set_version_2_0",
         guard |-> << >>,
         loops |-> << >>,
         actions |-> << Box("processing", "Set Half Duplex"),
                        Box("processing", "Set Implicit Reject"),
                        Box("processing", "Modulo := 8"),
                        Box("processing", "N1 := 2048"),
                        Box("processing", "k := 8"),
                        Box("processing", "T2 := 3000"),
                        Box("processing", "N2 := 10") >>]
    >>)
    @@ ("Check_Need_for_Response" :> << \* figc4.7
        [id |-> "t01_check_need_for_response_yes",
         guard |-> << Is("command_and_P_eq_1") >>,
         loops |-> << >>,
         actions |-> << Box("subroutine", "Enquiry_Response_F_1") >>],
        [id |-> "t02_check_need_for_response_no_no",
         guard |-> << Not("command_and_P_eq_1"), Not("response_and_F_eq_1") >>,
         loops |-> << >>,
         actions |-> << >>],
        [id |-> "t03_check_need_for_response_no_yes",
         guard |-> << Not("command_and_P_eq_1"), Is("response_and_F_eq_1") >>,
         loops |-> << >>,
         actions |-> << Box("signal_upper", "DL-ERROR Indication (A)") >>]
    >>)
    @@ ("Establish_Extended_Data_Link" :> << \* figc4.7
        [id |-> "t01_establish_extended_data_link_no",
         guard |-> << Not("mod_128") >>,
         loops |-> << >>,
         actions |-> << Box("processing", "Clear Exception Conditions"),
                        Box("processing", "RC := 1"),
                        Box("processing", "P := 1"),
                        Box("signal_lower", "SABM"),
                        Box("processing", "Stop T3"),
                        Box("processing", "Start T1") >>],
        [id |-> "t02_establish_extended_data_link_yes",
         guard |-> << Is("mod_128") >>,
         loops |-> << >>,
         actions |-> << Box("processing", "Clear Exception Conditions"),
                        Box("processing", "RC := 1"),
                        Box("processing", "P := 1"),
                        Box("signal_lower", "SABME"),
                        Box("processing", "Stop T3"),
                        Box("processing", "Start T1") >>]
    >>)
    @@ ("Establish_Data_Link" :> << \* figc4.7
        [id |-> "t01_establish_data_link_no",
         guard |-> << Not("mod_128") >>,
         loops |-> << >>,
         actions |-> << Box("processing", "Clear Exception Conditions"),
                        Box("processing", "RC := 1"),
                        Box("processing", "P := 1"),
                        Box("signal_lower", "SABM"),
                        Box("processing", "Stop T3"),
                        Box("processing", "Start T1") >>],
        [id |-> "t02_establish_data_link_yes",
         guard |-> << Is("mod_128") >>,
         loops |-> << >>,
         actions |-> << Box("processing", "Clear Exception Conditions"),
                        Box("processing", "RC := 1"),
                        Box("processing", "P := 1"),
                        Box("signal_lower", "SABME"),
                        Box("processing", "Stop T3"),
                        Box("processing", "Start T1") >>]
    >>)
    @@ ("Invoke_Retransmission" :> << \* figc4.7
        [id |-> "t01_invoke_retransmission",
         guard |-> << >>,
         loops |-> << Loop(4, 2, Not("vs_eq_X"), TRUE) >>,
         actions |-> << Box("processing", "Backtrack"),
                        Box("processing", "X := V(s)"),
                        Box("processing", "V(s) := N(r)"),
                        Box("internal_out", "Push Old I Frame onto Queue"),
                        Box("processing", "V(s) := V(s) + 1") >>]
    >>)
    @@ ("Check_I_Frame_Acknowledged" :> << \* figc4.7
        [id |-> "t01_check_i_frame_acknowledged_yes_yes",
         guard |-> << Is("peer_receiver_busy"), Is("T1_running") >>,
         loops |-> << >>,
         actions |-> << Box("processing", "V(a) := N(r)"),
                        Box("processing", "Stop T3") >>],
        [id |-> "t02_check_i_frame_acknowledged_yes_no",
         guard |-> << Is("peer_receiver_busy"), Not("T1_running") >>,
         loops |-> << >>,
         actions |-> << Box("processing", "V(a) := N(r)"),
                        Box("processing", "Stop T3"),
                        Box("processing", "Start T1") >>],
        [id |-> "t03_check_i_frame_acknowledged_no_yes",
         guard |-> << Not("peer_receiver_busy"), Is("nr_eq_vs") >>,
         loops |-> << >>,
         actions |-> << Box("processing", "V(a) := N(r)"),
                        Box("processing", "Stop T1"),
                        Box("processing", "Start T3"),
                        Box("subroutine", "Select_T1_Value") >>],
        [id |-> "t04_check_i_frame_acknowledged_no_no_yes",
         guard |-> << Not("peer_receiver_busy"), Not("nr_eq_vs"), Is("nr_eq_va") >>,
         loops |-> << >>,
         actions |-> << >>],
        [id |-> "t05_check_i_frame_acknowledged_no_no_no",
         guard |-> << Not("peer_receiver_busy"), Not("nr_eq_vs"), Not("nr_eq_va") >>,
         loops |-> << >>,
         actions |-> << Box("processing", "V(a) := N(r)"),
                        Box("processing", "Start T1") >>]
    >>)
    @@ ("Clear_Exception_Conditions" :> << \* figc4.7
        [id |-> "t01_clear_exception_conditions",
         guard |-> << >>,
         loops |-> << >>,
         actions |-> << Box("processing", "clear_peer_receiver_busy"),
                        Box("processing", "Clear Own Receiver Busy"),
                        Box("processing", "Clear Reject Condition"),
                        Box("processing", "Clear Sreject Condition"),
                        Box("processing", "Clear Acknowledge Pending"),
                        Box("processing", "Discard I Queue Entries") >>]
    >>)
    @@ ("N_r_Error_Recovery" :> << \* figc4.7
        [id |-> "t01_n_r_error_recovery",
         guard |-> << >>,
         loops |-> << >>,
         actions |-> << Box("signal_upper", "DL-ERROR Indication (J)"),
                        Box("subroutine", "Establish_Data_Link"),
                        Box("processing", "Clear Layer 3 Initiated") >>]
    >>)
    @@ ("Transmit_Enquiry" :> << \* figc4.7
        [id |-> "t01_transmit_enquiry_no",
         guard |-> << Not("own_receiver_busy") >>,
         loops |-> << >>,
         actions |-> << Box("processing", "P := 1"),
                        Box("processing", "N(r) := V(r)"),
                        Box("signal_lower", "RR Command"),
                        Box("processing", "Clear Acknowledge Pending"),
                        Box("processing", "Start T1") >>],
        [id |-> "t02_transmit_enquiry_yes",
