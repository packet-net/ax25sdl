------------------------- MODULE Ax25DataLinkTables -------------------------
(***************************************************************************)
(* GENERATED by codegen/src/Packet.Sdl.CodeGen.Tla from the JSON tables of *)
(* machine data_link. Do not edit by hand: fix the figure in               *)
(* packethacking/ax25spec, bump the pin, regenerate spec/json, then        *)
(*   dotnet run --project codegen/src/Packet.Sdl.CodeGen -- --tla          *)
(*                                                                         *)
(* Table data only, in the shape of spec/json: per state page, per event,  *)
(* the transitions in file order; per subroutine, its paths. A guard is a  *)
(* sequence of Is(atom) / Not(atom) conjuncts; an action is a box of one   *)
(* shape class naming its verb; a loop is a region of the action chain.    *)
(* Ax25Semantics.tla says what the verbs and atoms mean and runs the       *)
(* tables as the reference interpreter does. See docs/tla.md.              *)
(***************************************************************************)
EXTENDS TLC

\* An action box: its SDL shape class and its canonical verb.
Box(kind, verb) == [kind |-> kind, verb |-> verb]

\* A guard conjunct: <<atom, negated>>.
Is(atom) == <<atom, FALSE>>
Not(atom) == <<atom, TRUE>>

\* A loop region over actions[start .. start+len-1] (1-based); pred is the
\* continue condition; atEnd is do-while (TRUE) or while (FALSE).
Loop(start, len, pred, atEnd) == [start |-> start, len |-> len, pred |-> pred, atEnd |-> atEnd]

