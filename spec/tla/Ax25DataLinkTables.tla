                        Box("signal_lower", "RNR Command"),
                        Box("processing", "Clear Acknowledge Pending"),
                        Box("processing", "Start T1") >>]
    >>)
    @@ ("Enquiry_Response" :> << \* figc4.7
        [id |-> "t01_enquiry_response_yes_yes",
